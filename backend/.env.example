# Optional. If set, the agent uses Claude (tool-use loop) as its reasoning engine.
# If NOT set, the agent automatically falls back to a deterministic rule-based
# reasoning engine that implements the exact same buyer policy, so the whole
# system remains fully runnable/demoable without any API key or cost.
ANTHROPIC_API_KEY=

# Which Claude model to use when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-4-6

# SQLite file location (relative to backend/ working directory)
DATABASE_URL=sqlite:///./purchasing_agent.db

# Max self-correction retries the agent takes if PO validation fails
AGENT_MAX_RETRIES=2
